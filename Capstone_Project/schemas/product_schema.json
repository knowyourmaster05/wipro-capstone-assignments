{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomationExercise Product List",
  "type": "object",
  "properties": {
    "responseCode": { "type": "integer" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "price": { "type": "string" },
          "brand": { "type": "string" },
          "category": {
            "type": "object",
            "properties": {
              "usertype": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "object",
                    "properties": {
                      "usertype": { "type": "string" }
                    }
                  }
                ]
              },
              "category": { "type": "string" }
            }
          }
        },
        "required": ["id", "name"]
      }
    }
  },
  "required": ["responseCode", "products"]
}